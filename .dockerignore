# Keep the build context small and the image free of local-only state.
#
# .env is the important one: baking a real GEMINI_API_KEY, DATABASE_URL or
# JWT_SECRET_KEY into an image would leak it to anyone who can pull that image,
# and it would keep working after the secret was rotated.
.env
.env.*
!.env.example

.git
.gitignore
.github
.vscode
.idea

__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
*.egg-info/
dist/
build/

# Large local-only research artifacts (regenerate via scripts/).
data/clinvar_GRCh37.vcf.gz
data/variant_summary.txt.gz
data/clinvar_variant_dataset_enriched_tfidf_cache.pkl

# The review store now lives in PostgreSQL; the example file is documentation.
data/review_signoffs.json

# Tests and notebooks are not part of the runtime image.
tests/
analysis.ipynb
analysis_results/
*.ipynb_checkpoints