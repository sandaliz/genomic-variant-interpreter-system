# Keep the build context small and, critically, keep secrets and local state out
# of the image.
.git
.github
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
.coverage
htmlcov
.env
.vscode
.idea
.DS_Store

# Analysis/presentation artifacts the server never reads.
analysis_results
*.ipynb
*.ipynb_checkpoints

# Large reference archives that are regenerated, not shipped.
data/clinvar_GRCh37.vcf.gz
data/variant_summary.txt.gz
data/*_tfidf_cache.pkl
