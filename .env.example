# Google Gemini API configuration
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest

# ---- PostgreSQL (required) ----------------------------------------------------
# Create a FREE project at https://neon.com (no credit card), then copy its
# connection string here. It works the same on macOS, Windows and Linux -- the
# only reason Docker or a local PostgreSQL install is not required.
#
# Paste the string Neon gives you verbatim; do not hand-edit it. Then:
#   alembic upgrade head
#   python scripts/seed_plans.py
#   python scripts/create_admin.py
#
# Notes:
#   * Any PostgreSQL works -- Neon, a local install, an institutional server.
#   * Neon scales to zero after ~5 minutes idle, so the first request after a
#     break takes a second or two. That is normal, not a hang.
#   * The free tier has 1 GB; this project uses about 5 KB.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ---- Authentication ---------------------------------------------------------
# Generate a real secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# TWO secrets are required. The process refuses to start without both, because
# the development fallback is published in auth/security.py and anyone holding it
# could mint an administrator token.
#
#   JWT_SECRET_KEY      HMAC key that signs the access token
#   JWT_ENCRYPTION_KEY  AES key that encrypts it
#
# They must be different values. Reusing one key for signing and encryption is a
# recognised anti-pattern, and it would turn a signing-key leak into a decryption
# leak as well.
#
# Local only escape hatch -- never set this in a deployment:
#   JWT_ALLOW_DEV_SECRET=true
JWT_SECRET_KEY=replace-me-with-a-long-random-string
JWT_ENCRYPTION_KEY=replace-me-with-a-different-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Stamped into every token and checked on the way back in, so a token minted for
# a different service is refused even though its signature is valid.
JWT_ISSUER=variantlens
JWT_AUDIENCE=variantlens-api

# Session cookies default to Secure, which is correct for production over HTTPS.
# Browsers silently DROP a Secure cookie on plain HTTP, so local development on
# http://localhost needs this set to false. Never set it in production.
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax

# ---- Outbound email (password reset codes) ---------------------------------
# MAIL_DELIVERY=log is the default and the right choice locally: reset codes are
# printed to the log and echoed in the API response so the flow is testable
# without an inbox. Demo accounts use non-routable @example.com addresses, which
# no provider can deliver to anyway.
#
# To send real mail, switch to resend and add the key. With any real transport
# the code is NEVER returned in the response body, and a missing key is a
# startup error rather than a silently dropped message.
MAIL_DELIVERY=log
MAIL_FROM=VariantLens <noreply@variantlens.local>

# --- only needed when MAIL_DELIVERY=resend ---
# RESEND_API_KEY=re_your_key_here
# RESEND_FROM=VariantLens <noreply@yourdomain.com>

# --- only needed when MAIL_DELIVERY=smtp ---
# SMTP_HOST=smtp.your-institution.ac.uk
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ---- CORS -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173
