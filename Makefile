# VariantLens -- common tasks.
#
# Everything here assumes the shared virtualenv is already active. That is
# deliberate: a Makefile that activates a venv for you hides which interpreter
# is running, and this project has a notebook stack in one requirements file
# and a lean runtime in another.
#
#   source /path/to/.venv/bin/activate
#   make help

PYTHON ?= python
DATASET ?= data/clinvar_variant_dataset.xlsx
ENRICHED ?= data/clinvar_variant_dataset_enriched.xlsx

.DEFAULT_GOAL := help
.PHONY: help install install-api test test-js test-all lint types audit check \
        run coverage evaluate evaluate-rankers evaluate-real enrich \
        migrate revision docker-build docker-run clean

help:  ## Show this help
	@grep -hE '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) \
		| awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-20s\033[0m %s\n", $$1, $$2}'

# --- environment ----------------------------------------------------------
install:  ## Install the full development stack (includes the notebook deps)
	$(PYTHON) -m pip install -r requirements.txt

install-api:  ## Install only the runtime set the API needs
	$(PYTHON) -m pip install -r requirements-api.txt

# --- tests ----------------------------------------------------------------
test:  ## Run the Python test suite
	$(PYTHON) -m pytest tests/ -q

test-js:  ## Run the frontend tests (node test runner)
	node --test tests/js/

coverage:  ## Run the Python suite with a coverage report
	$(PYTHON) -m pytest tests/ -q --cov --cov-report=term-missing

test-all: test test-js  ## Run both suites

# --- static analysis (advisory: matches the CI job) -----------------------
lint:  ## ruff
	ruff check .

types:  ## mypy (retrieval/ only -- see pyproject.toml)
	mypy

audit:  ## pip-audit against the runtime requirements
	pip-audit -r requirements-api.txt

check: lint types audit  ## Everything CI runs without blocking

# --- running --------------------------------------------------------------
run:  ## Start the API with autoreload (http://127.0.0.1:8000)
	$(PYTHON) -m uvicorn api:app --reload

# --- data and evaluation --------------------------------------------------
enrich:  ## Rebuild the workbook with real ClinVar labels (network; slow)
	$(PYTHON) scripts/enrich_clinvar_labels.py

evaluate:  ## Full evaluation: classification, IR, calibration, fairness, ablation
	$(PYTHON) evaluation.py --dataset $(ENRICHED) --no-llm

evaluate-real:  ## Full evaluation with the LLM ablation enabled (Gemini API costs)
	$(PYTHON) evaluation.py --dataset $(ENRICHED)

evaluate-rankers:  ## TF-IDF vs BM25 vs hybrid, ranked corpus-wide (no LLM, no labels)
	$(PYTHON) evaluation.py --rankers-only --sample-size 50

# --- database -------------------------------------------------------------
migrate:  ## Apply migrations (needs DATABASE_URL)
	$(PYTHON) -m alembic upgrade head

revision:  ## New autogenerated migration: make revision m="add widgets"
	@test -n "$(m)" || (echo 'usage: make revision m="description"' && exit 1)
	$(PYTHON) -m alembic revision --autogenerate -m "$(m)"

# --- container ------------------------------------------------------------
docker-build:  ## Build the API image
	docker build -t variantlens:local .

docker-run:  ## Run the image on port 8000
	docker run --rm -p 8000:8000 --env-file .env variantlens:local

# --- housekeeping ---------------------------------------------------------
clean:  ## Remove caches, coverage output and the agent index cache
	find . -type d -name __pycache__ -prune -exec rm -rf {} +
	rm -rf .pytest_cache .ruff_cache .mypy_cache .coverage coverage.xml
	rm -f data/*_tfidf_cache.pkl
